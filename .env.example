# cp .env.example .env 후 값 변경. .env는 커밋하지 않는다.
POSTGRES_DB=gapcheck
POSTGRES_USER=gapcheck
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://gapcheck:change-me-local-only@postgres:5432/gapcheck

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=gapcheck
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_ENDPOINT=minio:9000
MINIO_BUCKETS=quarantine,raw,derived,reports

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_GEN_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
