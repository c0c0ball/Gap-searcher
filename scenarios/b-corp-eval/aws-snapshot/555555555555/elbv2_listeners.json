[
  {
    "LoadBalancerName": "dev-web",
    "Scheme": "internet-facing",
    "Type": "application",
    "LoadBalancerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:555555555555:loadbalancer/app/dev-web/5b0000000000b001",
    "Listeners": [
      {
        "Port": 443,
        "Protocol": "HTTPS",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-northeast-2:555555555555:targetgroup/tg/1"
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:ap-northeast-2:555555555555:certificate/cert-443"
          }
        ],
        "LoadBalancerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:555555555555:loadbalancer/app/dev-web/5b0000000000b001",
        "ListenerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:555555555555:listener/app/dev-web/5b0000000000b001/00000000000001bb"
      },
      {
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "Host": "#{host}",
              "Path": "/#{path}",
              "Query": "#{query}",
              "StatusCode": "HTTP_301"
            }
          }
        ],
        "LoadBalancerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:555555555555:loadbalancer/app/dev-web/5b0000000000b001",
        "ListenerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:555555555555:listener/app/dev-web/5b0000000000b001/0000000000000050"
      }
    ]
  }
]
